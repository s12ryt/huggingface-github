# onedrive-github 環境組態範本
# 複製為 .env 後填入實際值。所有值都不要提交進版本控制。

# --- 伺服器 ---
HOST=0.0.0.0
PORT=3000
# 對外網址。git clone 的位址與 cookie 的 secure 旗標都由此推導。
PUBLIC_URL=http://localhost:3000

# --- 安全 ---
# 工作階段簽章密鑰，至少 32 個字元。可用 openssl rand -base64 48 產生。
SESSION_SECRET=

# --- 註冊模式 ---
# open   = 任何人可用帳號密碼註冊
# invite = 需要管理員產生的邀請碼
# closed = 只有登入頁，註冊端點回傳與不存在路徑相同的 404
REGISTRATION_MODE=closed

# --- 儲存後端：HuggingFace 公開 Dataset ---
# 資料集識別，格式 <擁有者>/<名稱>。須先在 HuggingFace 建立。
HF_DATASET_ID=
# 修訂版本（分支），預設 main。
HF_REVISION=main
# 寫入權杖。讀取公開資料集不需要，但推送與建立 issue 必須有。
# 權限需含該資料集的 write。
HF_TOKEN=

# --- 儲存加密（必填）---
# 資料集是公開的，任何人都能下載，所以內容一律加密後才上傳。
# 32 位元組主金鑰，接受 64 個十六進位字元或 base64。
# 產生方式：openssl rand -hex 32
# 遺失此金鑰等於遺失全部資料，請另行備份。
STORAGE_ENCRYPTION_KEY=

# --- Git LFS ---
# 超過這個大小的檔案改走 Git LFS（batch 協商 + 轉送網址上傳）。
# .pack / .idx / .bin 這類副檔名會被 HuggingFace 的預設 .gitattributes
# 歸到 LFS，所以不論大小一律走 LFS，與此門檻無關。
LFS_THRESHOLD_BYTES=10MB

# --- 快取 ---
# 密文片段的記憶體 LRU 上限。支援 1024 / 512MB / 2GB 等寫法。
CACHE_MAX_BYTES=2GB

# --- 資料庫 ---
DATABASE_URL=file:./data/app.db
